generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  INTERNAL_TEAM
  COMMERCIAL
  TECHNICIAN
  FIELD
  SUPPLIER
  CLIENT
}

enum ClientKind {
  PERSON
  COMPANY
}

enum ServiceStatus {
  NEW
  PROPOSAL
  AWAITING_ACCEPTANCE
  CONTRACTED
  PLANNING
  PRODUCTION
  APPROVAL
  WORK
  AWAITING_CLIENT
  PAUSED
  DELIVERED
  CANCELED
}

enum ServiceType {
  TECHNICAL_PROJECT
  REGULARIZATION
  WORK_EXECUTION
  CONSULTING
  FIRE_SAFETY
  PROJECT_APPROVAL_WORK
}

enum DocumentVisibility {
  INTERNAL
  CLIENT_VISIBLE
  SUPPLIER_VISIBLE
}

model Tenant {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  memberships       Membership[]
  clients           Client[]
  properties        Property[]
  services          Service[]
  leads             Lead[]
  opportunities     Opportunity[]
  proposals         Proposal[]
  contracts         Contract[]
  projectPhases     ProjectPhase[]
  serviceTasks      ServiceTask[]
  approvalProcesses ApprovalProcess[]
  workLogs          WorkLog[]
  workMeasurements  WorkMeasurement[]
  documents         Document[]
  messages          Message[]
  timelineEvents    TimelineEvent[]
  aiInteractions    AiInteraction[]
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String?         @unique
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accounts       Account[]
  sessions       Session[]
  memberships    Membership[]
  assignedTasks  ServiceTask[]
  messages       Message[]
  aiInteractions AiInteraction[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Membership {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      Role
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model Client {
  id            String        @id @default(cuid())
  tenantId      String
  name          String
  kind          ClientKind    @default(PERSON)
  document      String?
  email         String?
  phone         String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  properties    Property[]
  services      Service[]
  leads         Lead[]
  opportunities Opportunity[]
  messages      Message[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Property {
  id         String    @id @default(cuid())
  tenantId   String
  clientId   String
  name       String
  address    String?
  city       String?
  state      String?
  postalCode String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  services   Service[]

  @@unique([tenantId, clientId, name])
  @@index([clientId])
}

model Service {
  id                String             @id @default(cuid())
  tenantId          String
  clientId          String
  propertyId        String?
  title             String
  type              ServiceType
  status            ServiceStatus      @default(NEW)
  description       String?
  startDate         DateTime?
  dueDate           DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  property          Property?          @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  leads             Lead[]
  opportunities     Opportunity[]
  proposals         Proposal[]
  contracts         Contract[]
  projectPhases     ProjectPhase[]
  tasks             ServiceTask[]
  approvalProcesses ApprovalProcess[]
  workLogs          WorkLog[]
  workMeasurements  WorkMeasurement[]
  documents         Document[]
  messages          Message[]
  timelineEvents    TimelineEvent[]
  aiInteractions    AiInteraction[]

  @@unique([tenantId, clientId, title])
  @@index([tenantId])
  @@index([clientId])
  @@index([propertyId])
}

model Lead {
  id        String   @id @default(cuid())
  tenantId  String
  clientId  String?
  serviceId String?
  source    String?
  title     String
  status    String   @default("OPEN")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@unique([tenantId, title])
  @@index([clientId])
  @@index([serviceId])
}

model Opportunity {
  id        String   @id @default(cuid())
  tenantId  String
  clientId  String
  serviceId String
  title     String
  stage     String   @default("QUALIFICATION")
  value     Decimal? @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, serviceId, title])
  @@index([clientId])
  @@index([serviceId])
}

model Proposal {
  id          String    @id @default(cuid())
  tenantId    String
  serviceId   String
  title       String
  status      String    @default("DRAFT")
  totalAmount Decimal?  @db.Decimal(12, 2)
  sentAt      DateTime?
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  contracts   Contract[]

  @@unique([tenantId, serviceId, title])
  @@index([serviceId])
}

model Contract {
  id         String    @id @default(cuid())
  tenantId   String
  serviceId  String
  proposalId String?
  number     String
  status     String    @default("DRAFT")
  signedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service    Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  proposal   Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@unique([tenantId, number])
  @@index([serviceId])
  @@index([proposalId])
}

model ProjectPhase {
  id          String        @id @default(cuid())
  tenantId    String
  serviceId   String
  name        String
  order       Int           @default(0)
  status      ServiceStatus @default(PLANNING)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service     Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tasks       ServiceTask[]

  @@unique([tenantId, serviceId, name])
  @@index([serviceId])
}

model ServiceTask {
  id          String        @id @default(cuid())
  tenantId    String
  serviceId   String
  phaseId     String?
  assigneeId  String?
  title       String
  description String?
  status      ServiceStatus @default(PLANNING)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service     Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  phase       ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  assignee    User?         @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  workLogs    WorkLog[]
  measurements WorkMeasurement[]

  @@unique([tenantId, serviceId, title])
  @@index([serviceId])
  @@index([phaseId])
  @@index([assigneeId])
}

model ApprovalProcess {
  id        String   @id @default(cuid())
  tenantId  String
  serviceId String
  authority String
  protocol  String?
  status    String   @default("NOT_SUBMITTED")
  dueDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, serviceId, authority])
  @@index([serviceId])
}

model WorkLog {
  id          String       @id @default(cuid())
  tenantId    String
  serviceId   String
  taskId      String?
  summary     String
  description String?
  performedAt DateTime
  hours       Decimal?     @db.Decimal(8, 2)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service     Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  task        ServiceTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([tenantId, serviceId, performedAt, summary])
  @@index([serviceId])
  @@index([taskId])
}

model WorkMeasurement {
  id          String       @id @default(cuid())
  tenantId    String
  serviceId   String
  taskId      String?
  description String
  quantity    Decimal      @db.Decimal(12, 2)
  unit        String
  measuredAt  DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service     Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  task        ServiceTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([tenantId, serviceId, description, measuredAt])
  @@index([serviceId])
  @@index([taskId])
}

model Document {
  id         String             @id @default(cuid())
  tenantId   String
  serviceId  String
  title      String
  url        String
  visibility DocumentVisibility @default(INTERNAL)
  mimeType   String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service    Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, serviceId, title])
  @@index([serviceId])
}

model Message {
  id        String   @id @default(cuid())
  tenantId  String
  serviceId String
  clientId  String?
  userId    String?
  body      String
  channel   String   @default("PORTAL")
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([serviceId])
  @@index([clientId])
  @@index([userId])
}

model TimelineEvent {
  id          String   @id @default(cuid())
  tenantId    String
  serviceId   String
  type        String
  title       String
  description String?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([serviceId])
}

model AiInteraction {
  id        String   @id @default(cuid())
  tenantId  String
  serviceId String
  userId    String?
  model     String
  prompt    String   @db.Text
  response  String?  @db.Text
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([serviceId])
  @@index([userId])
}
