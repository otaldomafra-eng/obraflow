generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  INTERNAL_TEAM
  COMMERCIAL
  TECHNICIAN
  FIELD
  SUPPLIER
  CLIENT
}

enum ClientKind {
  PERSON
  COMPANY
}

enum ServiceStatus {
  NEW
  PROPOSAL
  AWAITING_ACCEPTANCE
  CONTRACTED
  PLANNING
  PRODUCTION
  APPROVAL
  WORK
  AWAITING_CLIENT
  PAUSED
  DELIVERED
  CANCELED
}

enum ServiceType {
  TECHNICAL_PROJECT
  REGULARIZATION
  WORK_EXECUTION
  CONSULTING
  FIRE_SAFETY
  PROJECT_APPROVAL_WORK
}

enum DocumentVisibility {
  INTERNAL
  CLIENT_VISIBLE
  SUPPLIER_VISIBLE
}

model Tenant {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  memberships       Membership[]
  clients           Client[]
  properties        Property[]
  services          Service[]
  leads             Lead[]
  opportunities     Opportunity[]
  proposals         Proposal[]
  contracts         Contract[]
  projectPhases     ProjectPhase[]
  serviceTasks      ServiceTask[]
  approvalProcesses ApprovalProcess[]
  workLogs          WorkLog[]
  workMeasurements  WorkMeasurement[]
  documents         Document[]
  messages          Message[]
  timelineEvents    TimelineEvent[]
  aiInteractions    AiInteraction[]
}

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String?     @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Membership {
  id             String            @id @default(cuid())
  tenantId       String
  userId         String
  role           Role
  createdAt      DateTime          @default(now())
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTasks  ServiceTask[]
  messages       Message[]
  aiInteractions AiInteraction[]

  @@unique([tenantId, userId])
  @@index([tenantId, userId])
  @@index([userId])
}

model Client {
  id            String        @id @default(cuid())
  tenantId      String
  externalKey   String?
  name          String
  kind          ClientKind    @default(PERSON)
  document      String?
  email         String?
  phone         String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  properties    Property[]
  services      Service[]
  leads         Lead[]
  opportunities Opportunity[]
  messages      Message[]

  @@unique([tenantId, id])
  @@unique([tenantId, externalKey])
  @@index([tenantId])
}

model Property {
  id          String    @id @default(cuid())
  tenantId    String
  externalKey String?
  clientId    String
  name        String
  address     String?
  city        String?
  state       String?
  postalCode  String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client      Client    @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)
  services    Service[]

  @@unique([tenantId, id])
  @@unique([tenantId, clientId, id])
  @@unique([tenantId, externalKey])
  @@index([tenantId, clientId])
}

model Service {
  id                String            @id @default(cuid())
  tenantId          String
  externalKey       String?
  clientId          String
  propertyId        String?
  title             String
  type              ServiceType
  status            ServiceStatus     @default(NEW)
  description       String?
  startDate         DateTime?
  dueDate           DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client            Client            @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)
  property          Property?         @relation(fields: [tenantId, clientId, propertyId], references: [tenantId, clientId, id], onDelete: Restrict)
  leads             Lead[]
  opportunities     Opportunity[]
  proposals         Proposal[]
  contracts         Contract[]
  projectPhases     ProjectPhase[]
  tasks             ServiceTask[]
  approvalProcesses ApprovalProcess[]
  workLogs          WorkLog[]
  workMeasurements  WorkMeasurement[]
  documents         Document[]
  messages          Message[]
  timelineEvents    TimelineEvent[]
  aiInteractions    AiInteraction[]
  artNumber         String?
  technicalLead     String?
  councilRegNumber  String?
  internalCode      String?
  portalToken       String?       @unique
  portalEnabled     Boolean       @default(false)

  @@unique([tenantId, id])
  @@unique([tenantId, clientId, id])
  @@unique([tenantId, externalKey])
  @@index([tenantId])
  @@index([tenantId, clientId])
  @@index([tenantId, clientId, propertyId])
}

model Lead {
  id          String   @id @default(cuid())
  tenantId    String
  externalKey String?
  clientId    String?
  serviceId   String?
  source      String?
  title       String
  status      String   @default("OPEN")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client      Client?  @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)
  service     Service? @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, externalKey])
  @@index([tenantId, clientId])
  @@index([tenantId, serviceId])
}

model Opportunity {
  id          String   @id @default(cuid())
  tenantId    String
  externalKey String?
  clientId    String
  serviceId   String
  title       String
  stage       String   @default("QUALIFICATION")
  value       Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client      Client   @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)
  service     Service  @relation(fields: [tenantId, clientId, serviceId], references: [tenantId, clientId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, externalKey])
  @@index([tenantId, clientId])
  @@index([tenantId, clientId, serviceId])
}

model Proposal {
  id          String     @id @default(cuid())
  tenantId    String
  externalKey String?
  serviceId   String
  title       String
  status      String     @default("DRAFT")
  totalAmount Decimal?   @db.Decimal(12, 2)
  sentAt      DateTime?
  acceptedAt  DateTime?
  validUntil  DateTime?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  service     Service    @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  contracts   Contract[]
  documents   Document[]

  @@unique([tenantId, id])
  @@unique([tenantId, serviceId, id])
  @@unique([tenantId, externalKey])
  @@index([tenantId, serviceId])
}

model Contract {
  id          String    @id @default(cuid())
  tenantId    String
  externalKey String?
  serviceId   String
  proposalId  String?
  number      String
  status      String    @default("DRAFT")
  signedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  service     Service   @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  proposal    Proposal? @relation(fields: [tenantId, serviceId, proposalId], references: [tenantId, serviceId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@unique([tenantId, externalKey])
  @@index([tenantId, serviceId])
  @@index([tenantId, serviceId, proposalId])
}

model ProjectPhase {
  id          String        @id @default(cuid())
  tenantId    String
  externalKey String?
  serviceId   String
  name        String
  order       Int           @default(0)
  status      ServiceStatus @default(PLANNING)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  service     Service       @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  tasks       ServiceTask[]

  @@unique([tenantId, id])
  @@unique([tenantId, serviceId, id])
  @@unique([tenantId, externalKey])
  @@index([tenantId, serviceId])
}

model ServiceTask {
  id           String            @id @default(cuid())
  tenantId     String
  externalKey  String?
  serviceId    String
  phaseId      String?
  assigneeId   String?
  title        String
  description  String?
  status       ServiceStatus     @default(PLANNING)
  sortOrder    Int               @default(0)
  dueDate      DateTime?
  completedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  service      Service           @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  phase        ProjectPhase?     @relation(fields: [tenantId, serviceId, phaseId], references: [tenantId, serviceId, id], onDelete: Restrict)
  assignee     Membership?       @relation(fields: [tenantId, assigneeId], references: [tenantId, userId], onDelete: NoAction)
  workLogs     WorkLog[]
  measurements WorkMeasurement[]

  @@unique([tenantId, id])
  @@unique([tenantId, serviceId, id])
  @@unique([tenantId, externalKey])
  @@index([tenantId, serviceId])
  @@index([tenantId, serviceId, phaseId])
  @@index([tenantId, assigneeId])
}

model ApprovalProcess {
  id          String    @id @default(cuid())
  tenantId    String
  externalKey String?
  serviceId   String
  authority   String
  protocol    String?
  status      String    @default("NOT_SUBMITTED")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  service     Service   @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, externalKey])
  @@index([tenantId, serviceId])
}

model WorkLog {
  id          String       @id @default(cuid())
  tenantId    String
  externalKey String?
  serviceId   String
  taskId      String?
  summary     String
  description String?
  performedAt DateTime
  hours       Decimal?     @db.Decimal(8, 2)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  service     Service      @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  task        ServiceTask? @relation(fields: [tenantId, serviceId, taskId], references: [tenantId, serviceId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, externalKey])
  @@index([tenantId, serviceId])
  @@index([tenantId, serviceId, taskId])
}

model WorkMeasurement {
  id          String       @id @default(cuid())
  tenantId    String
  externalKey String?
  serviceId   String
  taskId      String?
  description String
  quantity    Decimal      @db.Decimal(12, 2)
  unit        String
  measuredAt  DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  service     Service      @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  task        ServiceTask? @relation(fields: [tenantId, serviceId, taskId], references: [tenantId, serviceId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, externalKey])
  @@index([tenantId, serviceId])
  @@index([tenantId, serviceId, taskId])
}

model Document {
  id          String             @id @default(cuid())
  tenantId    String
  externalKey String?
  serviceId   String
  proposalId  String?
  title       String
  url         String
  visibility  DocumentVisibility @default(INTERNAL)
  mimeType    String?
  storagePath String?
  fileName    String?
  fileSize    Int?
  uploadedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  service     Service            @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  proposal    Proposal?          @relation(fields: [tenantId, serviceId, proposalId], references: [tenantId, serviceId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, externalKey])
  @@index([tenantId, serviceId])
  @@index([tenantId, serviceId, proposalId])
}

model Message {
  id          String      @id @default(cuid())
  tenantId    String
  externalKey String?
  serviceId   String
  clientId    String?
  userId      String?
  body        String
  channel     String      @default("PORTAL")
  createdAt   DateTime    @default(now())
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  service     Service     @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  client      Client?     @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)
  user        Membership? @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, externalKey])
  @@index([tenantId, serviceId])
  @@index([tenantId, clientId])
  @@index([tenantId, userId])
}

model TimelineEvent {
  id          String   @id @default(cuid())
  tenantId    String
  externalKey String?
  serviceId   String
  type        String
  title       String
  description String?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  service     Service  @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, externalKey])
  @@index([tenantId, serviceId])
}

model AiInteraction {
  id          String      @id @default(cuid())
  tenantId    String
  externalKey String?
  serviceId   String
  userId      String?
  model       String
  prompt      String      @db.Text
  response    String?     @db.Text
  createdAt   DateTime    @default(now())
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  service     Service     @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  user        Membership? @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, externalKey])
  @@index([tenantId, serviceId])
  @@index([tenantId, userId])
}
