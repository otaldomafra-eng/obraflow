# ── Database ──────────────────────────────────────────
# Supabase Free connection string (transaction pooler)
DATABASE_URL=

# ── NextAuth v4 ───────────────────────────────────────
# Gerar com: openssl rand -base64 32
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# ── Tenant ────────────────────────────────────────────
# Slug do tenant padrão (recomendado após /setup criar o primeiro tenant)
# DEFAULT_TENANT_SLUG=

# ── Desenvolvimento apenas ────────────────────────────
# DEMO_LOGIN_ENABLED=true
# DEMO_LOGIN_PASSWORD=obraflow123

# ── Reservado para uso futuro ─────────────────────────
# S3_ENDPOINT="http://localhost:9000"
# S3_REGION="us-east-1"
# S3_BUCKET="obraflow-local"
# S3_ACCESS_KEY_ID="obraflow"
# S3_SECRET_ACCESS_KEY="obraflow-secret"
# AI_PROVIDER="mock"
# OPENAI_API_KEY=""
